APP_NAME=humanaClinica
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — desenvolvimento local (SQLite)
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Database — produção (MariaDB / MySQL) — descomente e ajuste na VPS
# -----------------------------------------------------------------------------
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=humana_saude
# DB_USERNAME=
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em HTTPS (produção), defina:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sem Jobs obrigatórios no momento — sync evita worker/Supervisor.
# Se no futuro houver filas, use database/redis e configure um worker.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Produção (SMTP exemplo — preencha na VPS, nunca no repositório):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="noreply@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Bootstrap local (AdminSeeder) — NÃO use em produção
# Em produção, crie o primeiro admin com:
#   php artisan app:bootstrap-first-administrator
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CLINIC_NAME="Clínica principal"
BOOTSTRAP_CLINIC_SLUG=clinica-principal
BOOTSTRAP_UNIT_NAME="Unidade principal"
BOOTSTRAP_UNIT_SLUG=unidade-principal

# -----------------------------------------------------------------------------
# Produção — checklist de .env na VPS (preencher manualmente)
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://seu-dominio.exemplo
# APP_KEY=   # php artisan key:generate
# LOG_LEVEL=warning
# QUEUE_CONNECTION=sync
# SESSION_SECURE_COOKIE=true
# DB_CONNECTION=mariadb
# Uploads de mídia (vídeo) até 100 MB: configure PHP (upload_max_filesize /
# post_max_size) e Nginx (client_max_body_size) para pelo menos 110 MB na VPS.

# -----------------------------------------------------------------------------
# TV TTS — Google Cloud Text-to-Speech (padrão). O JSON da service account
# fica fora do repositório; informe só o caminho absoluto.
# Driver "espeak" é o fallback local opcional (espeak-ng no Ubuntu).
# -----------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/service-account.json
# GOOGLE_TTS_LANGUAGE=pt-BR
# GOOGLE_TTS_VOICE=
# GOOGLE_TTS_SPEAKING_RATE=1.0
# TV_TTS_ENABLED=true
# TV_TTS_DRIVER=google
# TV_TTS_ESPEAK_BINARY=espeak-ng
# TV_TTS_VOICE=pt
# TV_TTS_RATE=145
# TV_TTS_CACHE_DISK=local
# TV_TTS_CACHE_DIRECTORY=tv-tts
# TV_TTS_CACHE_MAX_FILES=400
# TV_TTS_CACHE_MAX_AGE_DAYS=30
# TV_TTS_TIMEOUT=8

# -----------------------------------------------------------------------------
# Desk lease (ocupação de mesa/guichê no painel de atendimento)
# -----------------------------------------------------------------------------
# DESK_LEASE_TTL_SECONDS=90
# DESK_LEASE_HEARTBEAT_HINT_SECONDS=25
